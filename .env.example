# Copie para .env. Valores de exemplo: uso local apenas.
HTTP_PORT=8080
POSTGRES_PASSWORD=local_admin_change_me
IDENTITY_DB_PASSWORD=local_identity_change_me
EVENT_DB_PASSWORD=local_event_change_me
REGISTRATION_DB_PASSWORD=local_registration_change_me
PAYMENT_DB_PASSWORD=local_payment_change_me
NOTIFICATION_DB_PASSWORD=local_notification_change_me
RABBITMQ_USER=eventhub
RABBITMQ_PASSWORD=local_broker_change_me

# Geradas localmente por node scripts/init-identity-keys.mjs. Nunca versionar chaves reais.
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Execute node scripts/init-internal-key.mjs. Compartilhada somente entre serviços internos.
INTERNAL_API_KEY=
RESERVATION_TTL_SECONDS=900

