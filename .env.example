# Copie para .env; execute os scripts de inicialização antes do Docker Compose.
# Valores sensíveis em branco: serão gerados localmente, sem aparecer no terminal.
HTTP_PORT=8080
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
EVENT_DB_PASSWORD=
REGISTRATION_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
ATTENDANCE_DB_PASSWORD=
CERTIFICATE_DB_PASSWORD=
REPORTING_DB_PASSWORD=
PROVIDER_DB_PASSWORD=
RABBITMQ_USER=eventhub
RABBITMQ_PASSWORD=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
INTERNAL_API_KEY=
PAYMENT_PROVIDER_API_KEY=
RESERVATION_TTL_SECONDS=900
PUBLIC_APP_URL=http://localhost:8080

# mailbox: entrega acadêmica em arquivos locais; smtp: entrega no servidor escolhido.
MAIL_MODE=mailbox
MAIL_FROM=EventHub <noreply@eventhub.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
